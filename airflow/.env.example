# Copy to airflow/.env, edit locally; never commit the real .env.
# Replace <YOUR_HOME> with your actual Windows home path (forward slashes).
ADC_FILE=<YOUR_HOME>/AppData/Roaming/gcloud/application_default_credentials.json
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_PASSWORD
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_SECRET
